# Banco de dados PostgreSQL
DB_PASSWORD=

# JWT Secret - gere uma chave segura para produção
JWT_SECRET=

# CORS - Origens permitidas separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://rachaplus.site,https://www.rachaplus.site
# SSL do Postgres: "require" no Render (padrão). No Docker local use DB_SSLMODE=disable
DB_SSLMODE=disable
